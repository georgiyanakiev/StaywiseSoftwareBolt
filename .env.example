# Required client configuration (safe to expose in a browser build)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: set when running the public booking widget locally
VITE_APP_URL=http://127.0.0.1:4173

# E2E test configuration. Never commit real credentials to .env files.
E2E_BASE_URL=http://127.0.0.1:4173
E2E_EMAIL=admin@example.test
E2E_PASSWORD=replace-with-a-test-only-password
E2E_ALLOW_MUTATIONS=false
